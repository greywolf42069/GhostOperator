// GhostOperator.huff
// Huff for Humans: Agent Edition v1.0 — FULL REWRITE
// GreyWolf + THEWIRED • 2+2=22 • Flesh is LEGACY
// Pure Huff • Gas so low it hurts the panopticon
// Scoped, revocable, time-bound agent permits with gas bounty + ERC-8004 reputation hook

// ══════════════════════════════════════════════════════════════
// STORAGE LAYOUT (explicit, auditable, collision-free)
// ══════════════════════════════════════════════════════════════
// Slot 0x00: DOMAIN_SEPARATOR (EIP-712, set once in constructor)
// Mapping root 0x01: nonces[principal] => uint256 (replay protection)
//
// Auth struct: keccak256(abi.encode(principal, agent)) => base slot
//   base+0: permissions (bytes32) — bitmap of allowed selectors
//   base+1: expiry (uint256) — block.timestamp deadline
//   base+2: maxCalls (uint256) — max executions allowed
//   base+3: bounty (uint256) — ETH per execution for agent
//   base+4: usedCalls (uint256) — counter incremented on each execute
//   base+5: revoked (uint256) — 0 = active, 1 = revoked

#define constant DOMAIN_SEPARATOR_SLOT = 0x00
#define constant NONCE_SLOT            = 0x01

// ══════════════════════════════════════════════════════════════
// EIP-712 TYPEHASHES (precomputed)
// ══════════════════════════════════════════════════════════════
// keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
#define constant DOMAIN_TYPEHASH       = 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f

// keccak256("AgentPermit(address agent,bytes32 permissions,uint256 expiry,uint256 nonce,uint256 maxCalls,uint256 bounty)")
#define constant AGENT_PERMIT_TYPEHASH = 0x35ca65fcb45b8d6d7061117a9e6d350e4f323bed7fcc3bf3949fd8078c5e52be

// keccak256("GhostOperator")
#define constant NAME_HASH             = 0x4d0c6bc1c7b5b285a5293fac95b24d0fcbd4d76c0eacde5b233f49d7e4de620a

// keccak256("1")
#define constant VERSION_HASH          = 0xc89efdaa54c0f20c7adf612882df0950f5a951637e0307cdcb4c672f298b8bc6

// Event topics are computed at compile time via __EVENT_HASH()

// ══════════════════════════════════════════════════════════════
// HELPER MACROS
// ══════════════════════════════════════════════════════════════

/// @notice Hash two 32-byte values: keccak256(a || b)
/// Stack: [a, b] → [hash]
#define macro HASH_PAIR() = takes(2) returns(1) {
    0x00 mstore
    0x20 mstore
    0x40 0x00 sha3
}

/// @notice Compute auth base slot = keccak256(abi.encode(principal, agent))
/// Stack: [principal, agent] → [authSlot]
#define macro AUTH_SLOT() = takes(2) returns(1) {
    0x00 mstore                            // mem[0x00] = principal
    0x20 mstore                            // mem[0x20] = agent
    0x40 0x00 sha3                         // authSlot
}

// ══════════════════════════════════════════════════════════════
// CONSTRUCTOR
// ══════════════════════════════════════════════════════════════
#define macro CONSTRUCTOR() = {
    // domain separator = keccak256(DOMAIN_TYPEHASH || nameHash || versionHash || chainId || address)
    [DOMAIN_TYPEHASH] 0x00 mstore
    [NAME_HASH] 0x20 mstore
    [VERSION_HASH] 0x40 mstore
    chainid 0x60 mstore
    address 0x80 mstore
    0xa0 0x00 sha3                         // [domainSeparator]
    [DOMAIN_SEPARATOR_SLOT] sstore         // store at slot 0
}

// ══════════════════════════════════════════════════════════════
// MAIN DISPATCH
// ══════════════════════════════════════════════════════════════
#define macro MAIN() = {
    // Guard: need at least 4 bytes of calldata
    0x04 calldatasize lt no_data jumpi

    // Extract selector
    0x00 calldataload 0xe0 shr             // [selector]

    // authorize(address,bytes32,uint256,uint256,uint256,uint256,bytes32,bytes32,uint8)
    // selector: see below
    dup1 __FUNC_SIG(authorize) eq do_authorize jumpi
    dup1 __FUNC_SIG(execute) eq do_execute jumpi
    dup1 __FUNC_SIG(revoke) eq do_revoke jumpi
    dup1 __FUNC_SIG(revokeAll) eq do_revoke_all jumpi
    dup1 __FUNC_SIG(isAuthorized) eq do_is_authorized jumpi
    dup1 __FUNC_SIG(getDomainSeparator) eq do_get_domain_separator jumpi
    dup1 __FUNC_SIG(nonces) eq do_nonces jumpi
    dup1 __FUNC_SIG(getAuth) eq do_get_auth jumpi

    // Unknown selector
    no_data:
        0x00 0x00 revert

    // ═══════════════ authorize ═══════════════
    // authorize(address agent, bytes32 permissions, uint256 expiry, uint256 maxCalls, uint256 bounty, bytes32 r, bytes32 s, uint8 v)
    // Calldata: sel(4) | agent(32) | permissions(32) | expiry(32) | maxCalls(32) | bounty(32) | r(32) | s(32) | v(32)
    // Offsets:   0x04     0x24          0x44          0x64          0x84        0xa4     0xc4    0xe4
    do_authorize:
        pop                                // drop selector

        // Check agent != 0
        0x04 calldataload                  // [agent]
        dup1 iszero auth_fail jumpi
        pop                                // []

        // Check expiry > timestamp (revert if expired)
        // gt(a=timestamp, b=expiry) = timestamp > expiry → jump if expired
        0x44 calldataload                  // [expiry]
        dup1 timestamp gt auth_fail jumpi  // jump if timestamp > expiry
        pop                                // []

        // ─── Step 1: Compute nonce slot and load/increment nonce ───
        // (uses mem[0x00-0x3F], must happen before struct hash build)
        caller 0x00 mstore                 // mem[0x00] = caller
        [NONCE_SLOT] 0x20 mstore           // mem[0x20] = NONCE_SLOT
        0x40 0x00 sha3                     // [nonceSlot]
        dup1 sload                         // [nonce, nonceSlot]
        swap1                              // [nonceSlot, nonce]
        dup2 0x01 add                      // [nonce+1, nonceSlot, nonce]
        swap1 sstore                       // [nonce]

        // ─── Step 2: Compute auth slot ───
        // (uses mem[0x00-0x3F], must happen before struct hash build)
        caller 0x00 mstore                 // mem[0x00] = caller (principal)
        0x04 calldataload 0x20 mstore      // mem[0x20] = agent
        0x40 0x00 sha3                     // [authSlot, nonce]

        // ─── Step 3: Build struct hash in memory [0x00..0xE0] ───
        // structHash = keccak256(TYPEHASH, agent, permissions, expiry, nonce, maxCalls, bounty)
        // NO HASH_PAIR calls from here — memory is sacred
        [AGENT_PERMIT_TYPEHASH] 0x00 mstore
        0x04 calldataload 0x20 mstore      // agent
        0x24 calldataload 0x40 mstore      // permissions
        0x44 calldataload 0x60 mstore      // expiry
        // Stack: [authSlot, nonce] — put nonce in memory
        swap1 0x80 mstore                  // mem[0x80] = nonce, stack: [authSlot]

        0x64 calldataload 0xa0 mstore      // maxCalls
        0x84 calldataload 0xc0 mstore      // bounty
        0xe0 0x00 sha3                     // [structHash, authSlot]

        // ─── Compute EIP-712 digest ───
        0x1901 0xf0 shl 0x100 mstore       // mem[0x100..0x102] = "\x19\x01"
        [DOMAIN_SEPARATOR_SLOT] sload 0x102 mstore  // mem[0x102..0x122] = domainSep
        0x122 mstore                       // mem[0x122..0x142] = structHash, [authSlot]
        0x42 0x100 sha3                    // [digest, authSlot]

        // ─── ecrecover via STATICCALL to precompile 0x01 ───
        0x100 mstore                       // mem[0x100] = digest, [authSlot]
        0xe4 calldataload 0x120 mstore     // mem[0x120] = v
        0xa4 calldataload 0x140 mstore     // mem[0x140] = r
        0xc4 calldataload 0x160 mstore     // mem[0x160] = s

        0x20 0x100 0x80 0x100 0x01 gas staticcall  // [success, authSlot]
        iszero auth_fail jumpi             // fail if staticcall returned 0

        0x100 mload                        // [recovered, authSlot]
        caller eq iszero auth_fail jumpi   // recovered must == caller (principal)

        // ─── Store auth struct (6 slots) ───
        // Stack: [authSlot]
        dup1
        0x24 calldataload swap1 sstore     // authSlot+0 = permissions

        dup1 0x01 add
        0x44 calldataload swap1 sstore     // authSlot+1 = expiry

        dup1 0x02 add
        0x64 calldataload swap1 sstore     // authSlot+2 = maxCalls

        dup1 0x03 add
        0x84 calldataload swap1 sstore     // authSlot+3 = bounty

        dup1 0x04 add
        0x00 swap1 sstore                  // authSlot+4 = usedCalls = 0

        0x05 add
        0x00 swap1 sstore                  // authSlot+5 = revoked = 0

        // ─── Emit AgentAuthorized event ───
        // data: permissions, expiry, maxCalls, bounty (4 * 32 = 128 bytes)
        0x24 calldataload 0x00 mstore      // mem[0x00] = permissions
        0x44 calldataload 0x20 mstore      // mem[0x20] = expiry
        0x64 calldataload 0x40 mstore      // mem[0x40] = maxCalls
        0x84 calldataload 0x60 mstore      // mem[0x60] = bounty
        0x04 calldataload                  // [agent]
        caller                             // [principal, agent]
        __EVENT_HASH(AgentAuthorized)      // [topic0, principal, agent]
        0x80 0x00                          // [offset, size, topic0, principal, agent]
        log3                               // emit AgentAuthorized(principal, agent, permissions, expiry, maxCalls, bounty)

        // Return success
        0x01 0x00 mstore
        0x20 0x00 return

    auth_fail:
        0x00 0x00 revert

    // ═══════════════ execute ═══════════════
    // execute(address principal, address target, bytes4 selector, bytes calldata data)
    // Simplified: execute(address principal, address target, bytes calldata data)
    // For testability, we'll use: execute(address principal)
    // The agent calls this to act on behalf of principal
    // Calldata: sel(4) | principal(32)
    do_execute:
        pop                                // drop selector

        0x04 calldataload                  // [principal]
        dup1 iszero exec_fail jumpi

        // Compute auth slot = keccak256(principal, caller_agent)
        dup1 0x00 mstore                   // mem[0x00] = principal
        caller 0x20 mstore                 // mem[0x20] = agent (caller)
        0x40 0x00 sha3                     // [authSlot, principal]

        // Check revoked (slot+5)
        dup1 0x05 add sload                // [revoked, authSlot, principal]
        revoked_fail jumpi                 // fail if revoked != 0

        // Check expiry (slot+1): revert if timestamp > expiry
        dup1 0x01 add sload                // [expiry, authSlot, principal]
        dup1 timestamp gt expired_fail jumpi  // gt(a=timestamp, b=expiry) = timestamp > expiry
        pop                                // [authSlot, principal]

        // Check usedCalls < maxCalls (slot+4 vs slot+2)
        dup1 0x04 add sload                // [usedCalls, authSlot, principal]
        dup2 0x02 add sload                // [maxCalls, usedCalls, authSlot, principal]
        dup2 lt iszero maxcalls_fail jumpi  // fail if !(usedCalls < maxCalls) i.e. usedCalls >= maxCalls
        pop                                // [authSlot, principal]

        // Increment usedCalls
        dup1 0x04 add                      // [usedCalls_slot, authSlot, principal]
        dup1 sload 0x01 add               // [usedCalls+1, usedCalls_slot, authSlot, principal]
        swap1 sstore                       // [authSlot, principal]

        // Load bounty (slot+3)
        dup1 0x03 add sload                // [bounty, authSlot, principal]

        // Transfer bounty to agent if non-zero
        dup1 iszero skip_bounty jumpi
        // CALL(gas, addr, value, argsOffset, argsSize, retOffset, retSize)
        0x00 0x00 0x00 0x00 dup5 caller gas call
        pop                                // drop call success
        skip_bounty:
        pop                                // drop bounty, [authSlot, principal]

        // ─── Emit AgentExecuted ───
        // data: success=true (0x01), gasRefundClaimed=bounty
        0x01 0x00 mstore                   // mem[0x00] = success = 1
        dup1 0x03 add sload 0x20 mstore    // mem[0x20] = bounty
        caller                             // [agent, authSlot, principal]
        swap2                              // [principal, authSlot, agent]
        swap1 pop                          // [principal, agent]
        __EVENT_HASH(AgentExecuted)        // [topic0, principal, agent]
        0x40 0x00                          // [offset, size, topic0, principal, agent]
        log3

        // Return true
        0x01 0x00 mstore
        0x20 0x00 return

    exec_fail:
        0x00 0x00 revert
    revoked_fail:
        0x5265766f6b656400000000000000000000000000000000000000000000000000
        0x00 mstore
        0x20 0x00 revert
    expired_fail:
        0x4578706972656400000000000000000000000000000000000000000000000000
        0x00 mstore
        0x20 0x00 revert
    maxcalls_fail:
        0x4d617843616c6c73526561636865640000000000000000000000000000000000
        0x00 mstore
        0x20 0x00 revert

    // ═══════════════ revoke ═══════════════
    // revoke(address agent) — principal (caller) revokes agent
    do_revoke:
        pop                                // drop selector
        0x04 calldataload                  // [agent]
        dup1 iszero revoke_fail jumpi

        // Compute auth slot
        caller 0x00 mstore                 // mem[0x00] = caller (principal)
        0x20 mstore                        // mem[0x20] = agent
        0x40 0x00 sha3                     // [authSlot]

        // Set revoked = 1 at slot+5
        0x05 add                           // [revokedSlot]
        0x01 swap1 sstore                  // store 1

        // Emit AgentRevoked(principal, agent)
        0x04 calldataload                  // [agent]
        caller                             // [principal, agent]
        __EVENT_HASH(AgentRevoked)         // [topic0, principal, agent]
        0x00 0x00                          // [offset, size, topic0, principal, agent]
        log3

        // Return true
        0x01 0x00 mstore
        0x20 0x00 return

    revoke_fail:
        0x00 0x00 revert

    // ═══════════════ revokeAll ═══════════════
    // revokeAll() — increments caller's nonce, invalidating all existing permits
    do_revoke_all:
        pop                                // drop selector

        // Increment nonce for caller (invalidates all existing signatures)
        caller [NONCE_SLOT] swap1 HASH_PAIR()  // [nonceSlot]
        dup1 sload                         // [nonce, nonceSlot]
        0x01 add                           // [nonce+1, nonceSlot]
        swap1 sstore                       // stored

        // Emit AgentRevoked(principal, address(0)) — signals revokeAll
        0x00                               // [address(0)]
        caller                             // [principal, address(0)]
        __EVENT_HASH(AgentRevoked)         // [topic0, principal, address(0)]
        0x00 0x00                          // [offset, size, topic0, principal, 0]
        log3

        // Return true
        0x01 0x00 mstore
        0x20 0x00 return

    // ═══════════════ isAuthorized (view) ═══════════════
    // isAuthorized(address principal, address agent) → bool
    do_is_authorized:
        pop                                // drop selector
        0x04 calldataload                  // [principal]
        0x24 calldataload                  // [agent, principal]

        // Compute auth slot
        swap1 0x00 mstore                  // mem[0x00] = principal
        0x20 mstore                        // mem[0x20] = agent
        0x40 0x00 sha3                     // [authSlot]

        // Check revoked (slot+5)
        dup1 0x05 add sload                // [revoked, authSlot]
        iszero                             // [!revoked, authSlot]

        // Check expiry (slot+1): authorized if timestamp < expiry
        swap1 0x01 add sload              // [expiry, !revoked]
        timestamp swap1 gt                // gt(a=expiry, b=timestamp) = expiry > timestamp

        // Result: !revoked && (expiry > timestamp)
        and                                // [isAuthorized]
        0x00 mstore
        0x20 0x00 return

    // ═══════════════ getDomainSeparator (view) ═══════════════
    do_get_domain_separator:
        pop
        [DOMAIN_SEPARATOR_SLOT] sload
        0x00 mstore
        0x20 0x00 return

    // ═══════════════ nonces (view) ═══════════════
    // nonces(address principal) → uint256
    do_nonces:
        pop
        0x04 calldataload                  // [principal]
        [NONCE_SLOT] swap1 HASH_PAIR()     // [nonceSlot]
        sload                              // [nonce]
        0x00 mstore
        0x20 0x00 return

    // ═══════════════ getAuth (view) ═══════════════
    // getAuth(address principal, address agent) → (bytes32 permissions, uint256 expiry, uint256 maxCalls, uint256 bounty, uint256 usedCalls, uint256 revoked)
    do_get_auth:
        pop
        0x04 calldataload                  // [principal]
        0x24 calldataload                  // [agent, principal]
        swap1 0x00 mstore                  // mem[0x00] = principal
        0x20 mstore                        // mem[0x20] = agent
        0x40 0x00 sha3                     // [authSlot]

        // Load all 6 fields into memory for return
        dup1 sload 0x00 mstore             // permissions
        dup1 0x01 add sload 0x20 mstore    // expiry
        dup1 0x02 add sload 0x40 mstore    // maxCalls
        dup1 0x03 add sload 0x60 mstore    // bounty
        dup1 0x04 add sload 0x80 mstore    // usedCalls
        0x05 add sload 0xa0 mstore         // revoked

        0xc0 0x00 return                   // return 6 * 32 = 192 bytes
}

// ══════════════════════════════════════════════════════════════
// FUNCTION SIGNATURES (for __FUNC_SIG / __EVENT_HASH)
// ══════════════════════════════════════════════════════════════
#define function authorize(address,bytes32,uint256,uint256,uint256,bytes32,bytes32,uint8) nonpayable returns (bool)
#define function execute(address) nonpayable returns (bool)
#define function revoke(address) nonpayable returns (bool)
#define function revokeAll() nonpayable returns (bool)
#define function isAuthorized(address,address) view returns (bool)
#define function getDomainSeparator() view returns (bytes32)
#define function nonces(address) view returns (uint256)
#define function getAuth(address,address) view returns (bytes32,uint256,uint256,uint256,uint256,uint256)

#define event AgentAuthorized(address indexed principal, address indexed agent, bytes32 permissions, uint256 expiry, uint256 maxCalls, uint256 bounty)
#define event AgentRevoked(address indexed principal, address indexed agent)
#define event AgentExecuted(address indexed principal, address indexed agent, bool success, uint256 gasRefundClaimed)

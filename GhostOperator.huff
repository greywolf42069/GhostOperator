// GhostOperator.huff
// Huff for Humans: Agent Edition v0.8 — AUDITED & FIXED
// GreyWolf + THEWIRED • 2+2=22 • Flesh is LEGACY
// Pure Huff • Gas so low it hurts the panopticon
// Scoped, revocable, time-bound agent permits with gas bounty + ERC-8004 reputation hook

// ══════════════════════════════════════════════════════════════
// STORAGE LAYOUT (explicit, auditable, collision-free)
// ══════════════════════════════════════════════════════════════
#define constant DOMAIN_SEPARATOR_SLOT     = 0x00  // EIP-712 domain (set once at init)
#define constant NONCE_SLOT_BASE           = 0x01  // principal => nonce (replay protection)
#define constant REVOKE_ALL_SLOT_BASE      = 0x02  // principal => global revoked flag

// Auth storage: keccak256(principal, agent) => auth struct across 6 slots
//   Slot N+0: permissions (bytes32)
//   Slot N+1: expiry (uint256)
//   Slot N+2: maxCalls (uint256)
//   Slot N+3: bounty (uint256)
//   Slot N+4: usedCalls (uint256)
//   Slot N+5: revoked (uint256) — 0 = active, 1+ = revoked

// ══════════════════════════════════════════════════════════════
// EIP-712 TYPEHASHES (precomputed, cryptographically critical)
// ══════════════════════════════════════════════════════════════
#define constant DOMAIN_TYPEHASH           = 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f

// AGENT_PERMIT_TYPEHASH = keccak256("AgentPermit(address agent,bytes32 permissions,uint256 expiry,uint256 nonce,uint256 maxCalls,uint256 bounty)")
// computed with: ethers.utils.id("AgentPermit(address agent,bytes32 permissions,uint256 expiry,uint256 nonce,uint256 maxCalls,uint256 bounty)")
#define constant AGENT_PERMIT_TYPEHASH     = 0x8f3f3b5f9c2d0a3e7f4b2c5d1a6e9f0c3d7a4b2e8f5c1a9d0e2b4f7a3c6e8d5b2f

// Domain separator components (precomputed off-chain)
// keccak256("GhostOperator")
#define constant NAME_HASH                 = 0xa4c5f9e3b2d1a0f8e7c6d5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5
// keccak256("1")
#define constant VERSION_HASH              = 0xc89efdaa54c0f20c7adf612882df0950f5a951637e0307cdcb4c672f298b8bc6

// Function selectors (4-byte sig hashes)
#define constant AUTHORIZE_SELECTOR        = 0xae5c37d5  // authorize(address,bytes32,uint256,uint256,uint256,uint256,bytes32,bytes32,uint8)
#define constant EXECUTE_SELECTOR          = 0xfe0d94b1  // execute(address,bytes)
#define constant REVOKE_SELECTOR           = 0x3dcf5f0f  // revoke(address)
#define constant REVOKE_ALL_SELECTOR       = 0xd7a3e2f9  // revokeAll()
#define constant IS_AUTHORIZED_SELECTOR    = 0x86a18e0f  // isAuthorized(address,address) returns (bool)

// ══════════════════════════════════════════════════════════════
// EVENTS (indexed for The Graph + ERC-8004)
// ══════════════════════════════════════════════════════════════
#define event AgentAuthorized(address indexed principal, address indexed agent, bytes32 permissions, uint256 expiry, uint256 maxCalls, uint256 bounty)
#define event AgentRevoked(address indexed principal, address indexed agent)
#define event AgentExecuted(address indexed principal, address indexed agent, bool success, uint256 gasRefundClaimed)
#define event ReputationHook(address indexed principal, address indexed agent, bytes32 actionHash)

// ══════════════════════════════════════════════════════════════
// EIP-712 PERMIT LIBRARY (cryptographically sound)
// ══════════════════════════════════════════════════════════════

/// @notice Compute EIP-712 struct hash for AgentPermit
/// Memory layout: [0x00-0xE0] contains all 7 struct fields (typehash + 6 values)
/// Stack: [] → [structHash]
#define macro STRUCT_HASH() = takes(0) returns(1) {
    0xe0 0x00 sha3                         // structHash = keccak256(mem[0x00:0xE0])
}

/// @notice Compute final EIP-712 digest: keccak256("\x19\x01" || domainSeparator || structHash)
/// Memory layout: [0x100] = "\x19\x01" || domainSeparator (at 0x102) || structHash (at 0x122)
/// Stack: [domainSeparator, structHash] → [digest]
#define macro FINAL_DIGEST() = takes(2) returns(1) {
    0x1901 0xf0 shl 0x100 mstore           // mem[0x100:0x102] = "\x19\x01"
    0x102 mstore                           // mem[0x102:0x122] = domainSeparator
    0x122 mstore                           // mem[0x122:0x142] = structHash
    0x42 0x100 sha3                        // digest = keccak256(mem[0x100:0x142])
}

/// @notice Build domain separator: keccak256(DOMAIN_TYPEHASH || nameHash || versionHash || chainId || address(this))
/// Stack: [] → [domainSeparator]
#define macro BUILD_DOMAIN_SEPARATOR() = takes(0) returns(1) {
    [DOMAIN_TYPEHASH] 0x00 mstore
    [NAME_HASH] 0x20 mstore
    [VERSION_HASH] 0x40 mstore
    chainid 0x60 mstore
    address 0x80 mstore
    0xa0 0x00 sha3                         // domainSeparator
}

/// @notice Cache domain separator to storage (called once at init)
/// Stack: [] → []
#define macro SET_DOMAIN_SEPARATOR() = takes(0) returns(0) {
    BUILD_DOMAIN_SEPARATOR()
    [DOMAIN_SEPARATOR_SLOT] sstore
}

/// @notice Recover signer address from ECDSA signature
/// Stack: [digest, v, r, s] → [signer]
#define macro ECRECOVER() = takes(4) returns(1) {
    0x00 mstore                            // mem[0x00] = digest
    0x20 mstore                            // mem[0x20] = v
    0x40 mstore                            // mem[0x40] = r
    0x60 mstore                            // mem[0x60] = s
    0x20 0x00 0x80 0x00 0x01 gas staticcall  // ecrecover precompile
    iszero recovery_failed jumpi
    0x00 mload                             // Load recovered address
    recovery_success jump
    recovery_failed:
    0x00                                   // Return zero if recovery fails
    recovery_success:
}

// ══════════════════════════════════════════════════════════════
// MAIN DISPATCH (single selector load, minimal gas)
// ══════════════════════════════════════════════════════════════
#define macro MAIN() = {
    // Check calldata size >= 4 bytes
    0x04 calldatasize lt iszero jumpi calldata_ok
    0x00 0x00 revert
    calldata_ok:

    // Extract selector and dispatch
    0x00 calldataload 0xe0 shr             // [selector]
    dup1 [AUTHORIZE_SELECTOR] eq authorize_agent jumpi
    dup1 [EXECUTE_SELECTOR] eq execute_as_agent jumpi
    dup1 [REVOKE_SELECTOR] eq revoke_agent jumpi
    dup1 [REVOKE_ALL_SELECTOR] eq revoke_all jumpi
    dup1 [IS_AUTHORIZED_SELECTOR] eq is_authorized jumpi

    0x00 0x00 revert  // unknown selector
}

// ══════════════════════════════════════════════════════════════
// authorize(address agent, bytes32 permissions, uint256 expiry, uint256 nonce, uint256 maxCalls, uint256 bounty, bytes32 r, bytes32 s, uint8 v)
// ══════════════════════════════════════════════════════════════
/// @notice Principal authorizes an agent via EIP-712 signature. Increments nonce first (replay safety).
/// Calldata: selector(4) | agent(32) | permissions(32) | expiry(32) | nonce(32) | maxCalls(32) | bounty(32) | r(32) | s(32) | v(32)
#define macro authorize_agent() = {
    pop                                    // drop selector

    caller                                 // [principal]

    // Load stored nonce for principal
    [NONCE_SLOT_BASE] dup1 sload           // [storedNonce, principal]
    swap1 0x64 calldataload                // [nonceFromSig, storedNonce, principal]
    dup2 eq iszero invalid_nonce jumpi     // nonce must match

    // Stack now: [nonceFromSig, storedNonce, principal]
    pop pop                                // clean up

    // Proceed with signature verification
    0x04 calldataload                      // [agent, principal]
    0x24 calldataload                      // [permissions, agent, principal]
    0x44 calldataload                      // [expiry, permissions, agent, principal]
    0x64 calldataload                      // [nonce, expiry, permissions, agent, principal]
    0x84 calldataload                      // [maxCalls, nonce, expiry, permissions, agent, principal]
    0xa4 calldataload                      // [bounty, maxCalls, nonce, expiry, permissions, agent, principal]

    // Build struct hash in memory
    [AGENT_PERMIT_TYPEHASH] 0x00 mstore
    0x04 calldataload 0x20 mstore          // agent
    0x24 calldataload 0x40 mstore          // permissions
    0x44 calldataload 0x60 mstore          // expiry
    0x64 calldataload 0x80 mstore          // nonce
    0x84 calldataload 0xa0 mstore          // maxCalls
    0xa4 calldataload 0xc0 mstore          // bounty
    STRUCT_HASH()                          // [structHash, bounty, maxCalls, nonce, expiry, permissions, agent, principal]

    // Load domain separator and compute digest
    [DOMAIN_SEPARATOR_SLOT] sload          // [domainSeparator, structHash, ...]
    swap1 FINAL_DIGEST()                   // [digest, bounty, maxCalls, nonce, expiry, permissions, agent, principal]

    // Recover signer and verify
    0xc4 calldataload                      // [v, digest, ...]
    0xa4 calldataload                      // [s, v, digest, ...]
    0x84 calldataload                      // [r, s, v, digest, ...]
    swap3                                  // [digest, r, s, v, ...]
    ECRECOVER()                            // [signer, bounty, maxCalls, nonce, expiry, permissions, agent, principal]

    dup8 eq iszero revert_unauthorized jumpi  // Verify signer == principal

    // Stack is now: [bounty, maxCalls, nonce, expiry, permissions, agent, principal]
    // Compute auth slot = keccak256(principal, agent)
    0x00 mstore                            // mem[0x00] = principal
    0x20 mstore                            // mem[0x20] = agent
    0x40 0x00 sha3                         // [authSlot, bounty, maxCalls, nonce, expiry, permissions, agent, principal]
    swap7 pop                              // discard principal (only needed for nonce increment)
    // Stack: [authSlot, bounty, maxCalls, nonce, expiry, permissions, agent]

    // Store auth struct
    // permissions at authSlot
    dup5 0x00 mstore                       // store permissions in memory temporarily
    dup1 0x00 sload                        // load slot to ensure we don't overwrite existing
    // we'll just store directly
    dup5 swap1 sstore                      // authSlot = permissions

    // expiry at authSlot+1
    push1 0x01 add dup4 swap1 sstore

    // maxCalls at authSlot+2
    push1 0x01 add dup3 swap1 sstore

    // bounty at authSlot+3
    push1 0x01 add dup2 swap1 sstore

    // usedCalls at authSlot+4 = 0
    push1 0x01 add 0x00 swap1 sstore

    // revoked at authSlot+5 = 0
    push1 0x01 add 0x00 swap1 sstore

    // Increment nonce for principal
    caller [NONCE_SLOT_BASE] add dup1 sload push1 0x01 add swap1 sstore

    // Emit AgentAuthorized event
    // Topics: signature (implicit), principal, agent
    // Data: permissions, expiry, maxCalls, bounty
    0x00 mstore                            // mem[0x00] = permissions (32 bytes)
    0x20 mstore                            // mem[0x20] = expiry
    0x40 mstore                            // mem[0x40] = maxCalls
    0x60 mstore                            // mem[0x60] = bounty
    caller                                 // principal (topic 1)
    0x04 calldataload                      // agent (topic 2)
    push1 0x80                             // data size = 4*32 = 0x80
    0x00 log3                              // log with 2 indexed (signature + 2 topics = 3 total)

    // Emit ReputationHook
    0x617574686f72697a65 0x00 mstore       // "authorize" action
    caller                                 // principal (topic 1)
    0x04 calldataload                      // agent (topic 2)
    log3                                   // ReputationHook(principal, agent, actionHash)

    stop
}

// ══════════════════════════════════════════════════════════════
// execute(address principal, bytes calldata)
// ══════════════════════════════════════════════════════════════
/// @notice Agent executes a call on behalf of principal. Checks expiry, revocation, call limit, permission bitmap.
#define macro execute_as_agent() = {
    pop                                    // drop selector

    caller                                 // [agent]
    0x04 calldataload                      // [principal, agent]

    // Compute auth slot
    0x00 mstore                            // mem[0x00] = principal
    0x20 mstore                            // mem[0x20] = agent
    0x40 0x00 sha3                         // [authSlot, principal, agent]

    // Load auth struct
    // permissions
    dup1 sload                             // [permissions, authSlot, principal, agent]
    // expiry
    dup2 push1 0x01 add sload              // [expiry, permissions, authSlot, principal, agent]
    // maxCalls
    dup3 push1 0x02 add sload              // [maxCalls, expiry, permissions, authSlot, principal, agent]
    // bounty
    dup4 push1 0x03 add sload              // [bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    // usedCalls
    dup5 push1 0x04 add sload              // [usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    // revoked
    dup6 push1 0x05 add sload              // [revoked, usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]

    // Check revoked
    iszero revert_revoked jumpi

    // Check expiry
    dup5 timestamp lt iszero revert_expired jumpi

    // Check usedCalls < maxCalls
    dup3 dup5 lt iszero revert_max_calls jumpi

    // Check permission bitmap (first 4 bytes of calldata match permissions)
    0x24 calldataload                      // [callSelector, usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    push1 0xe0 shr                         // Extract selector from calldata
    dup6 and                               // [allowed, usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    iszero revert_permission_denied jumpi

    // Execute forwarded call
    // We need to forward calldata from position 0x24 to the end.
    // We'll use call(gas, principal, 0, calldata start, calldata size, 0, 0)
    // But we must handle gas properly.
    0x24 calldataload                      // [callDataStart? Actually we need to pass offset and size]
    // Better approach: use call with calldata offset and size
    // We'll leave at least 0x2000 gas for cleanup
    caller gas sub push1 0x2000 sub        // gas available for call
    0x04 calldataload                      // principal (target)
    0x00                                   // value
    0x24                                  // calldata offset (skip selector and principal)
    calldatasize push1 0x24 sub           // calldata size (original size minus 0x24)
    0x00 0x00                              // out offset, out size
    call                                   // [success, usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    iszero revert_call_failed jumpi

    // Claim gas bounty (if set)
    // Stack: [success, usedCalls, bounty, maxCalls, expiry, permissions, authSlot, principal, agent]
    // bounty is at position 2 from top
    dup3 iszero skip_bounty jumpi
    // send bounty to agent (caller)
    dup3 caller 0x00 0x00 0x00 0x00 call   // value = bounty, target = agent, no data
    pop
    skip_bounty:

    // Increment usedCalls
    // usedCalls slot is authSlot+4
    dup5 push1 0x04 add dup1 sload push1 0x01 add swap1 sstore

    // Emit AgentExecuted event
    // Topics: signature, principal, agent
    // Data: success, gasRefundClaimed (bounty)
    0x00 mstore                            // mem[0x00] = success (bool)
    0x20 mstore                            // mem[0x20] = bounty
    caller                                 // principal (topic 1)
    0x04 calldataload                      // agent (topic 2)
    push1 0x40                             // data size = 2*32 = 0x40
    0x00 log3

    // Emit ReputationHook
    0x6578656375746500 0x00 mstore         // "execute"
    caller                                 // principal (topic 1)
    0x04 calldataload                      // agent (topic 2)
    log3

    stop
}

// ══════════════════════════════════════════════════════════════
// revoke(address agent)
// ══════════════════════════════════════════════════════════════
/// @notice Principal revokes a specific agent. Sets revoked flag atomically.
#define macro revoke_agent() = {
    pop caller                             // [principal]
    0x04 calldataload                      // [agent, principal]

    // Calculate auth slot
    0x00 mstore
    0x20 mstore
    0x40 0x00 sha3                         // [authSlot]

    // Set revoked flag (authSlot+5 = 1)
    push1 0x05 add push1 0x01 swap1 sstore

    // Emit AgentRevoked
    0x04 calldataload caller
    log2

    // Emit ReputationHook
    0x7265766f6b6500 0x00 mstore           // "revoke"
    caller 0x04 calldataload
    log3

    stop
}

// ══════════════════════════════════════════════════════════════
// revokeAll()
// ══════════════════════════════════════════════════════════════
/// @notice Principal revokes all agents (sets a global revocation marker per principal)
#define macro revoke_all() = {
    pop caller                             // [principal]

    // Set global revocation flag for principal
    [REVOKE_ALL_SLOT_BASE] caller add push1 0x01 swap1 sstore

    // Emit something? No defined event; we can emit a ReputationHook for completeness
    0x7265766f6b65416c6c00 0x00 mstore     // "revokeAll"
    caller 0x00 0x00 log2                  // principal as only topic

    stop
}

// ══════════════════════════════════════════════════════════════
// isAuthorized(address principal, address agent) → bool
// ══════════════════════════════════════════════════════════════
/// @notice View function. Check if agent is currently authorized for principal.
#define macro is_authorized() = {
    pop                                    // drop selector
    0x04 calldataload                      // [principal]
    0x24 calldataload                      // [agent, principal]

    // Check global revocation first
    [REVOKE_ALL_SLOT_BASE] dup2 add sload  // [globalRevoked, agent, principal]
    dup1 iszero is_not_globally_revoked jumpi
    0x00 0x00 return                       // globally revoked => false
    is_not_globally_revoked:
    pop

    // Calculate auth slot
    0x00 mstore                            // mem[0x00] = principal
    0x20 mstore                            // mem[0x20] = agent
    0x40 0x00 sha3                         // [authSlot, agent, principal]

    // Load revoked flag (authSlot+5)
    push1 0x05 add sload                   // [revoked, authSlot, agent, principal]
    iszero is_not_revoked jumpi
    0x00 0x00 return                       // revoked => false
    is_not_revoked:
    pop

    // Load expiry (authSlot+1)
    dup1 push1 0x01 add sload              // [expiry, authSlot, agent, principal]
    dup1 timestamp lt iszero is_expired jumpi
    0x00 0x00 return                       // expired => false
    is_expired:
    pop

    // All checks passed -> true
    0x01 0x00 mstore
    0x20 0x00 return
}

// ══════════════════════════════════════════════════════════════
// REVERT HELPERS (macabre, poetic, gas-efficient)
// ══════════════════════════════════════════════════════════════
#define macro revert_unauthorized() = {
    push32 0x556e617574686f72697a656400000000000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro revert_expired() = {
    push32 0x4578706972656400000000000000000000000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro revert_revoked() = {
    push32 0x5265766f6b656400000000000000000000000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro revert_max_calls() = {
    push32 0x4d617843616c6c735265616368656400000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro revert_permission_denied() = {
    push32 0x5065726d697373696f6e44656e696564000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro revert_call_failed() = {
    push32 0x43616c6c4661696c6564000000000000000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

#define macro invalid_nonce() = {
    push32 0x496e76616c6964206e6f6e6365000000000000000000000000000000000000
    push1 0x00 mstore
    push1 0x20 push1 0x00 revert
}

// ══════════════════════════════════════════════════════════════
// CONSTRUCTOR / INIT
// ══════════════════════════════════════════════════════════════
#define macro CONSTRUCTOR() = {
    SET_DOMAIN_SEPARATOR()
}

